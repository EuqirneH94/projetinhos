+  try {
+    assert.deepEqual(h.audio.settings, { enabled: false, master: 0.22, music: 0.18, ambience: 0.3, effects: 0.4, voice: DEFAULT_AUDIO.voice });
+    h.audio.set("voice", 4); assert.equal(h.audio.settings.voice, 1);
