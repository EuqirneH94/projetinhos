diff --git a/client/src/render-assets.ts b/client/src/render-assets.ts
new file mode 100644
index 0000000..d1bab0c
--- /dev/null
+++ b/client/src/render-assets.ts
@@ -0,0 +1,57 @@
+import { Group, Mesh, type Object3D } from "three";
+import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
+
+/** Original, distributable source assets. No external host or undocumented
+ * art download. The procedural object remains usable on network/parse failure. */
+export const ART_ASSETS = {
+  resonator: {
+    id: "EDF-RESONATOR-001",
+    url: "/art/resonator.gltf",
+    author: "Ecos dos Faróis / original procedural production in Codex",
+    provenance: "/art/PROVENANCE.json",
+    status: "provisional" as const,
+  },
+};
+export function assetSlot(fallback: Object3D, url = ART_ASSETS.resonator.url) {
+  const root = new Group();
+  root.add(fallback);
+  root.userData.assetState = "loading";
+  root.userData.assetId = ART_ASSETS.resonator.id;
+  let disposed = false;
+  const loader = new GLTFLoader();
+  const ready = loader.loadAsync(url).then(
+    (gltf) => {
+      if (disposed) { disposeAsset(gltf.scene); return; }
+      // Do not replace fallback until parsing and validation have succeeded.
+      let meshes = 0;
+      gltf.scene.traverse((o) => {
+        if (o instanceof Mesh) { meshes++; o.castShadow = o.receiveShadow = true; }
+      });
+      if (!meshes) throw new Error("Asset contains no renderable mesh");
+      root.remove(fallback);
+      disposeAsset(fallback);
+      root.add(gltf.scene);
+      root.userData.assetState = "loaded";
+    },
+  ).catch(() => {
+    if (!disposed) {
+      root.userData.assetState = "fallback";
+      console.warn("EDF art: local resonator unavailable; procedural fallback retained.");
+    }
+  });
+  return {
+    root, ready,
+    dispose() {
+      disposed = true;
+      disposeAsset(root);
+      root.clear();
+    },
+  };
+}
+function disposeAsset(root: Object3D) {
+  root.traverse((o) => {
+    if (!(o instanceof Mesh)) return;
+    o.geometry.dispose();
+    for (const material of Array.isArray(o.material) ? o.material : [o.material]) material.dispose();
+  });
+}
diff --git a/client/src/render-camera.ts b/client/src/render-camera.ts
new file mode 100644
index 0000000..7a39460
--- /dev/null
+++ b/client/src/render-camera.ts
@@ -0,0 +1,46 @@
+import { Box3, Ray, Vector3 } from "three";
+
+/** A swept camera body, rather than a zero-width ray, keeps the near plane out
+ * of wall corners. The target is the actor's chest; gameplay collision is
+ * independent and never changed here. */
+export function cameraPosition(
+  target: Vector3,
+  desired: Vector3,
+  obstacles: readonly Box3[],
+  ground: (x: number, z: number) => number,
+  radius = 0.32,
+): { position: Vector3; distance: number; blocked: boolean } {
+  const vector = desired.clone().sub(target);
+  const requested = vector.length();
+  if (requested < 1e-5)
+    return { position: target.clone(), distance: 0, blocked: false };
+  const direction = vector.divideScalar(requested);
+  const ray = new Ray(target, direction);
+  let distance = requested;
+  for (const bounds of obstacles) {
+    const expanded = bounds.clone().expandByScalar(radius);
+    // A player on a collider boundary must not send the camera through the
+    // building to its far exit. Collapse locally; let the player orbit out.
+    if (expanded.containsPoint(target)) {
+      distance = Math.min(distance, 0.45);
+      continue;
+    }
+    const intersection = ray.intersectBox(expanded, new Vector3());
+    if (intersection)
+      distance = Math.min(distance, Math.max(0.35, intersection.distanceTo(target) - 0.04));
+  }
+  // Search along the whole segment: testing only the destination lets a
+  // camera pass through a ridge and emerge on its other side.
+  const steps = Math.max(1, Math.ceil(distance / 0.3));
+  for (let i = 1; i <= steps; i++) {
+    const at = (distance * i) / steps;
+    const point = target.clone().addScaledVector(direction, at);
+    if (point.y < ground(point.x, point.z) + radius) {
+      distance = Math.max(0.35, (distance * (i - 1)) / steps);
+      break;
+    }
+  }
+  const position = target.clone().addScaledVector(direction, distance);
+  position.y = Math.max(position.y, ground(position.x, position.z) + radius);
+  return { position, distance, blocked: distance < requested - 0.001 };
+}
