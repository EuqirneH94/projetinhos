+  <header>
+    <div><span class="eyebrow">ECOS DOS FARÓIS · ATELIÊ 3D</span><h1>Náquiro masculino</h1></div>
+    <a href="/?character=naquiro-male">Experimentar no jogo ↗</a>
+  </header>
+  <main>
+    <section class="stage" aria-label="Inspeção tridimensional do personagem">
