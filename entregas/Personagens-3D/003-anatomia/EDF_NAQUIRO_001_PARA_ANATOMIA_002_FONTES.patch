+def mesh_checks(report):
+    return all(not report[key] for key in (
+        'nonfinite_vertices', 'zero_area_faces', 'collapsed_edges', 'loose_edges',
+        'unused_vertices', 'edges_with_more_than_two_faces', 'same_direction_shared_edges'))
