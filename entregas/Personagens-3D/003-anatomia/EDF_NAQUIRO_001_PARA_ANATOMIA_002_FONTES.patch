+    contour=[]
+    for i in range(len(controls)):
+        a,b,c,d=[Vector(controls[k%len(controls)]) for k in (i-1,i,i+1,i+2)]
+        for n in range(4):
+            t=n/4
+            p=.5*((2*b)+(-a+c)*t+(2*a-5*b+4*c-d)*t*t+(-a+3*b-3*c+d)*t*t*t)
