{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "noEmit": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["client/src", "server/src", "shared", "tests", "scripts", "vite.config.ts"]
}
